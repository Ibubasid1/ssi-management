{
  "name": "ssi-management",
  "private": true,
  "workspaces": ["client", "server"],
  "engines": {
    "node": "^24.13.1"
  },
  "scripts": {
    "dev": "concurrently -n client,server \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}